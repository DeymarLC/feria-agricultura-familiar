# ============================================================
# Plantilla de variables de entorno para la API Flask.
# COPIA este archivo a `.env` y rellena tus valores reales.
# NUNCA subas `.env` al repositorio (está en .gitignore).
# ============================================================

# Entorno de ejecución: development | testing | production
FLASK_ENV=development

# Claves secretas: usa contraseñas largas y aleatorias.
SECRET_KEY=genera-una-clave-secreta-larga-y-aleatoria
JWT_SECRET=genera-otra-clave-secreta-para-los-tokens

# Duración del token de acceso en minutos (ej. 60 = 1 hora)
JWT_EXPIRES_MINUTES=60

# Cadena de conexion a PostgreSQL.
# Local: postgresql://usuario:contrasena@localhost:5432/nombre_bd
# Render: DATABASE_URL lo inyecta el propio servicio de Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feria_db

# Orígenes permitidos para CORS, separados por coma.
# Prohibido usar "*" en producción: solo listar tu frontend.
# Ejemplo producción: https://feria-agricultura.onrender.com
CORS_ORIGINS=http://localhost:5173